# Copy to .env and adjust. Every value here is optional.

# Sources. A ref can be a branch, a tag or a commit SHA.
SKYFIRE_GIT=https://github.com/gacou54/SkyFire_548.git
SKYFIRE_REF=main
PLAYERBOTS_GIT=https://github.com/gacou54/mod-playerbots.git
PLAYERBOTS_REF=main
# Build from local checkouts instead (see docker-compose.dev.yml):
#COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml
#SKYFIRE_SRC=../SkyFire_548
#PLAYERBOTS_SRC=../mod-playerbots

# Client data (dbc/maps/vmaps/mmaps). Extracted into this folder by the extractor.
SKYFIRE_DATA_DIR=./data
# 5.4.8 client folder (contains Data/), only needed by the extractor.
WOW_CLIENT_DIR=/path/to/World of Warcraft

# Address the game client connects to. Use the host's LAN/public IP when the
# client is on another machine.
REALM_ADDRESS=127.0.0.1
REALM_NAME=MoP Playerbots

AUTH_PORT=3724
WORLD_PORT=8085

DB_USER=skyfire
DB_PASSWORD=skyfire
DB_ROOT_PASSWORD=skyfire-root
# MySQL is published on the host only on this interface.
DB_BIND=127.0.0.1
DB_PORT=3306
DB_BUFFER_POOL_SIZE=1G

# Playerbots. Bot accounts are created on startup as RNDBOT1..RNDBOT<ACCOUNTS>.
PLAYERBOTS_ENABLE=1
PLAYERBOTS_RANDOM_BOTS=1
PLAYERBOTS_MAX_BOTS=20
PLAYERBOTS_AUTOCREATE=1
PLAYERBOTS_ACCOUNTS=20
# Bot accounts can log in through the authserver; change this if AUTH_PORT
# is reachable from other machines.
PLAYERBOTS_ACCOUNT_PASSWORD=password
PLAYERBOTS_MIN_LEVEL=90
PLAYERBOTS_MAX_LEVEL=90

# Any other worldserver.conf or playerbots.conf key: SFCONF_ + key, "." as "__".
#SFCONF_Rate__XP__Kill=5
#SFCONF_Playerbots__RandomBotJoinLfg=1

# Import SkyFire's sql/pending_updates on startup (development only).
IMPORT_PENDING_UPDATES=0

# Remote admin; published on 127.0.0.1 only.
RA_ENABLE=0
SOAP_ENABLE=0

# Build settings.
SKYFIRE_BUILD_TYPE=Release
SKYFIRE_BUILD_JOBS=
# Container user; match your host uid/gid so it can write SKYFIRE_DATA_DIR.
SKYFIRE_UID=1000
SKYFIRE_GID=1000
